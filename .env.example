# Copy to .env (git-ignored) and fill in. Variables already set in the shell win.
# Read by `python -m spec_bridge.eval.experiment` (spec_bridge/envfile.py, D-034).

# Cloud comparison runs only (--provider openai). Leave blank for local Ollama runs.
OPENAI_API_KEY=

# Set to 1 for local-only runs: refuses any non-loopback model server (NFR-01).
# Leave unset for --provider openai, or the cloud server is refused.
# OFFLINE=1
