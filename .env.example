# Copy to .env (git-ignored) and fill in. Variables already set in the shell win.
# Read by `python -m spec_bridge.eval.experiment` (spec_bridge/envfile.py, D-034).

# Cloud comparison runs only (--provider openai). Leave blank for local Ollama runs.
OPENAI_API_KEY=

# Set to 1 for local-only runs: refuses any non-loopback model server (NFR-01).
# Leave unset for --provider openai, or the cloud server is refused.
# OFFLINE=1

# Review app (uvicorn spec_bridge.api.app:app), D-116. All optional; the defaults are shown.
# Where jobs, uploads, BOMs and the app registry live.
# SPEC_BRIDGE_APP_DIR=var/app
# Model provider: ollama (local) or openai (cloud comparison, needs OPENAI_API_KEY and no OFFLINE=1).
# SPEC_BRIDGE_PROVIDER=ollama
# Model name; empty means exaone3.5:7.8b for ollama.
# SPEC_BRIDGE_MODEL=
# Model server URL; empty means http://127.0.0.1:11434 for ollama.
# SPEC_BRIDGE_BASE_URL=
